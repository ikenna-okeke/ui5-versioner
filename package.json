{
  "name": "ui5-lifecycle",
  "version": "0.1.1",
  "description": "CLI to detect changed SAPUI5 apps in a monorepo and bump sap.app.applicationVersion.version per app.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "ui5-version": "./bin/ui5-version.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "release": "node ./bin/ui5-version.js release",
    "release:dry": "node ./bin/ui5-version.js release --dry-run"
  }
}
